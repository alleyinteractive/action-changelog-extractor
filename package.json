{
  "name": "action-changelog-extractor",
  "version": "1.0.0",
  "description": "GitHub Action to parse and extract changelog information",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "github-action",
    "changelog",
    "parser",
    "release-notes"
  ],
  "author": "Alley Interactive",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@actions/core": "^1.10.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
