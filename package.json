{
  "name": "@alleyinteractive/changelog-extractor",
  "version": "0.4.0",
  "type": "module",
  "description": "Parse and extract structured information from Keep a Changelog formatted changelogs",
  "main": "src/parser.js",
  "bin": {
    "changelog-extractor": "./src/cli.js"
  },
  "scripts": {
    "build": "npm run prettier && npm run package",
    "fix-and-build": "npm run prettier:fix && npm run package",
    "package:watch": "npm run package -- --watch",
    "package": "npx rollup --config rollup.config.js",
    "prepublishOnly": "npm test",
    "prettier:fix": "npx prettier --write .",
    "prettier": "npx prettier --check .",
    "release:major": "npm version major && npm publish --access public && git push --follow-tags",
    "release:minor": "npm version minor && npm publish --access public && git push --follow-tags",
    "release:patch": "npm version patch && npm publish --access public && git push --follow-tags",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest"
  },
  "keywords": [
    "changelog",
    "parser",
    "keep-a-changelog",
    "release-notes",
    "github-action",
    "cli"
  ],
  "author": "Alley Interactive",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alleyinteractive/action-changelog-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/alleyinteractive/action-changelog-extractor/issues"
  },
  "homepage": "https://github.com/alleyinteractive/action-changelog-extractor#readme",
  "files": [
    "src/",
    "dist/",
    "cli.js",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "rollup": "^4.53.3"
  },
  "dependencies": {
    "@actions/core": "^1.10.1"
  }
}
